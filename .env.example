# ---------------------------------------------------------------------------
# esi-whiteboard — configuration (copier vers .env sur le serveur)
#    cp .env.example .env && nano .env
# ---------------------------------------------------------------------------

# --- Serveur ---
PORT=5858
# URL publique (HTTPS). Sert aussi à valider le cookie Secure et le redirect OAuth.
APP_URL=https://whiteboard.example.com
# Dossier de données (rooms SQLite, assets, historique IA, usage). Créé si absent.
DATA_DIR=/opt/tldraw/data
# Secret de signature du cookie de session. Générer : openssl rand -hex 32
SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# --- Discord OAuth2 (OBLIGATOIRE — voir README > Setup Discord) ---
# Le login Discord est la porte d'entrée : sans lui, aucun accès au tableau.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OBLIGATOIRE : verrouille l'accès aux seuls membres de CE serveur (ta promo/classe/groupe).
# Le serveur refuse de démarrer sans. Le login est refusé aux non-membres.
DISCORD_GUILD_ID=

# --- Agent IA ---
AGENT_PROVIDER=deepseek
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# deepseek-flash : rapide, multimodal (images) ET tool-calling.
AGENT_MODEL=deepseek-flash
# (optionnel) remplace entièrement le prompt système par défaut :
# AGENT_SYSTEM_PROMPT=

# --- tldraw (build du client) ---
# Une instance PUBLIQUE (production) nécessite une clé de licence tldraw :
#   https://tldraw.dev/pricing
# Sans clé, le SDK affiche un filigrane "Made with tldraw". Ne pas le retirer.
# À fournir au build du client (client/.env ou variable d'environnement) :
# VITE_TLDRAW_LICENSE_KEY=tldraw-xxxxxxxxxxxx
